#!/usr/bin/env bash
#
# fst-team — FST four-agent CLI-only orchestrator
#
# Operates the four-agent FST engineering team from the Integration session
# using only the Kilo CLI and Linux terminal. No VS Code, no Agent Manager,
# no GUI. All worker sessions run in their independent Git worktrees.
#
# Usage: fst-team <command> [args...]
#
# Commands:
#   status      Show all agents, sessions, tasks, worktrees
#   dispatch    <agent> <task>   Dispatch a task to a worker agent (async)
#   resume      <session_id>     Resume an existing Kilo session by ID
#   collect     <session_id|task_id>  Wait for completion and collect results
#   sync                    Synchronize branches and read ledgers from refs
#   stop        <session_id>     Stop a running session
#   doctor                  Health check: CLI, agents, worktrees, state
#
# State: ~/.local/state/fst-team/  (runtime-only, never committed to Git)
#   agents/     <agent>.json     — current agent state
#   sessions/   <session_id>.json — session state
#   tasks/      <task_id>.json    — task state
#   logs/       *.log            — kilo run output logs
#   locks/      *.lock           — flock files for atomic writes
#
# Exit codes:
#   0 = success
#   1 = general error
#   2 = agent busy / duplicate dispatch
#   3 = session not found
#   4 = invalid arguments

set -uo pipefail

###############################################################################
# Constants and paths
###############################################################################

STATE_DIR="${FST_TEAM_STATE_DIR:-$HOME/.local/state/fst-team}"
AGENT_DIR="$STATE_DIR/agents"
SESSION_DIR="$STATE_DIR/sessions"
TASK_DIR="$STATE_DIR/tasks"
LOG_DIR="$STATE_DIR/logs"
LOCK_DIR="$STATE_DIR/locks"

INTEGRATION_WORKTREE="/home/monil/Desktop/CXX/FeinStatic-agents/integration"

declare -A AGENT_WORKTREE=(
  [fst-research]="/home/monil/Desktop/CXX/FeinStatic-agents/research"
  [fst-implementation]="/home/monil/Desktop/CXX/FeinStatic-agents/implementation"
  [fst-verification]="/home/monil/Desktop/CXX/FeinStatic-agents/verification"
  [fst-debugging]="/home/monil/Desktop/CXX/FeinStatic-agents/debugging"
)

declare -A AGENT_LEDGER=(
  [fst-research]="docs/fst/operations/research-status.md"
  [fst-implementation]="docs/fst/operations/implementation-status.md"
  [fst-verification]="docs/fst/operations/verification-status.md"
  [fst-debugging]="docs/fst/operations/defect-register.md"
)

declare -A AGENT_BRANCH=(
  [fst-research]="team/research"
  [fst-implementation]="team/implementation"
  [fst-verification]="team/verification"
  [fst-debugging]="team/debugging"
)

KILO_BIN="kilo"
MAX_WAIT_SECONDS=300
SESSION_POLL_INTERVAL=2

KILO_BIN="kilo"

###############################################################################
# Atomic JSON write helper (single file, no cross-file locking needed)
###############################################################################

# json_write <file> <key_path> <value>
# key_path is dot-separated, e.g. "status" or "metadata.exit_code"
json_write() {
  local file="$1"
  local key_path="$2"
  local value="$3"
  local lock_file="$LOCK_DIR/$(basename "$file").lock"
  exec 9>"$lock_file"
  flock -n 9 || { echo "ERROR: could not acquire lock for $file" >&2; return 1; }
  python3 -c "
import json, os, sys
path = '$file'
try:
    with open(path) as f:
        data = json.load(f)
except Exception:
    data = {}
parts = '$key_path'.split('.')
obj = data
for p in parts[:-1]:
    if p not in obj:
        obj[p] = {}
    obj = obj[p]
obj[parts[-1]] = '$value'
tmp = path + '.tmp.$$'
with open(tmp, 'w') as f:
    json.dump(data, f, indent=2)
import os as _os
_os.rename(tmp, path)
" 2>/dev/null
  local rc=$?
  exec 9>&-
  return $rc
}

# json_read <file> <key_path>
json_read() {
  local file="$1"
  local key_path="$2"
  python3 -c "
import json, os, sys
try:
    with open('$file') as f:
        data = json.load(f)
except Exception:
    sys.exit(0)
parts = '$key_path'.split('.')
obj = data
for p in parts:
    if isinstance(obj, dict) and p in obj:
        obj = obj[p]
    else:
        sys.exit(0)
if obj is None:
    sys.exit(0)
print(obj)
" 2>/dev/null
}

# json_keys <file>
json_keys() {
  local file="$1"
  python3 -c "
import json, sys
try:
    with open('$file') as f:
        data = json.load(f)
except Exception:
    sys.exit(0)
if isinstance(data, dict):
    print(' '.join(data.keys()))
" 2>/dev/null
}

# init_file <file> <default_json>
init_file() {
  local file="$1"
  local default="$2"
  if [ ! -f "$file" ]; then
    echo "$default" > "$file"
  fi
}

###############################################################################
# Initialization
###############################################################################

init_state() {
  mkdir -p "$AGENT_DIR" "$SESSION_DIR" "$TASK_DIR" "$LOG_DIR" "$LOCK_DIR"
  for a in fst-research fst-implementation fst-verification fst-debugging; do
    init_file "$AGENT_DIR/$a.json" '{"session_id":"","pid":"","log_file":"","task":"","status":"idle","started_at":""}'
  done
}

now_iso() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

now_epoch() {
  date +%s
}

###############################################################################
# Helpers
###############################################################################

is_valid_agent() {
  local agent="$1"
  [ -n "${AGENT_WORKTREE[$agent]+x}" ]
}

extract_session_id() {
  local log_file="$1"
  grep -m1 '"sessionID"' "$log_file" 2>/dev/null \
    | sed -n 's/.*"sessionID":"\([^"]*\)".*/\1/p' \
    | head -1
}

extract_text_output() {
  local log_file="$1"
  LOG_FILE="$log_file" python3 -c "
import json, os, sys
try:
    with open(os.environ['LOG_FILE']) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                obj = json.loads(line)
            except Exception:
                continue
            if obj.get('type') == 'text':
                text = obj.get('part', {}).get('text', '')
                if text:
                    print(text)
except Exception:
    pass
" 2>/dev/null
}

extract_commit_shas() {
  local log_file="$1"
  grep -oE '[0-9a-f]{40}' "$log_file" 2>/dev/null | sort -u
}

is_agent_busy() {
  local agent="$1"
  local worktree="${AGENT_WORKTREE[$agent]}"

  # Read agent state for active task
  local pid task_id session_id
  pid="$(json_read "$AGENT_DIR/$agent.json" "pid")"
  task_id="$(json_read "$AGENT_DIR/$agent.json" "task_id")"
  session_id="$(json_read "$AGENT_DIR/$agent.json" "session_id")"

  # No PID recorded → no active task
  if [ -z "$pid" ]; then
    return 1
  fi

  # If exit file exists, the bash wrapper has finished kilo run and wrote
  # the exit code. Task is complete regardless of whether the wrapper PID
  # is still briefly alive (it may be exiting).
  if [ -n "$task_id" ] && [ -f "$LOG_DIR/${task_id}.exit" ]; then
    return 1
  fi

  # PID is dead → process crashed or was killed without writing exit file.
  # This is a STALE task, not busy.
  if ! kill -0 "$pid" 2>/dev/null; then
    return 1
  fi

  # PID alive, no exit file → task is genuinely still running.
  return 0
}

get_agent_session_id() {
  local agent="$1"
  json_read "$AGENT_DIR/$agent.json" "session_id"
}

get_agent_pid() {
  local agent="$1"
  json_read "$AGENT_DIR/$agent.json" "pid"
}

get_agent_log() {
  local agent="$1"
  json_read "$AGENT_DIR/$agent.json" "log_file"
}

###############################################################################
# Commands
###############################################################################

cmd_doctor() {
  echo "=== fst-team doctor ==="
  echo ""

  echo "--- Kilo CLI ---"
  local kilo_version
  kilo_version="$("$KILO_BIN" --version 2>&1)"
  echo "kilo --version: $kilo_version"
  if command -v python3 >/dev/null 2>&1; then
    echo "python3: available ($(python3 --version 2>&1))"
  else
    echo "python3: NOT available (required for JSON parsing)"
  fi
  echo ""

  echo "--- Agent definitions ---"
  local ask_found=0
  for f in /home/monil/Desktop/CXX/FeinStatic-agents/integration/.kilo/agents/fst-*.md; do
    local name
    name="$(basename "$f")"
    if grep -q 'bash: ask' "$f" 2>/dev/null; then
      echo "  $name: CONTAINS bash: ask (NEEDS FIX)"
      ask_found=1
    else
      echo "  $name: bash: allow (OK)"
    fi
  done
  if [ "$ask_found" -eq 0 ]; then
    echo "  All agent definitions: bash: allow (OK)"
  fi
  echo ""

  echo "--- Worktrees ---"
  for agent in fst-research fst-implementation fst-verification fst-debugging; do
    local wt="${AGENT_WORKTREE[$agent]}"
    if [ -d "$wt" ]; then
      local branch head status
      branch="$(git -C "$wt" branch --show-current 2>/dev/null || echo "unknown")"
      head="$(git -C "$wt" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
      status="$(git -C "$wt" status --porcelain 2>/dev/null | wc -l)"
      echo "  $agent: $wt"
      echo "    branch=$branch head=$head dirty_files=$status"
    else
      echo "  $agent: $wt — MISSING"
    fi
  done
  echo ""

  echo "--- Integration worktree ---"
  local ibranch ihead idirty
  ibranch="$(git -C "$INTEGRATION_WORKTREE" branch --show-current 2>/dev/null || echo "unknown")"
  ihead="$(git -C "$INTEGRATION_WORKTREE" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
  idirty="$(git -C "$INTEGRATION_WORKTREE" status --porcelain 2>/dev/null | wc -l)"
  echo "  fst-integration: $INTEGRATION_WORKTREE"
  echo "    branch=$ibranch head=$ihead dirty_files=$idirty"
  echo ""

  echo "--- State ---"
  echo "  state_dir: $STATE_DIR"
  echo "  agents: $(ls "$AGENT_DIR"/*.json 2>/dev/null | wc -l)"
  echo "  sessions: $(ls "$SESSION_DIR"/*.json 2>/dev/null | wc -l)"
  echo "  tasks: $(ls "$TASK_DIR"/*.json 2>/dev/null | wc -l)"
  echo ""

  echo "=== doctor complete ==="
}

cmd_status() {
  echo "=== fst-team status ==="
  echo ""

  echo "--- Agents ---"
  for agent in fst-research fst-implementation fst-verification fst-debugging; do
    local wt="${AGENT_WORKTREE[$agent]}"
    local session_id pid log_file agent_status exit_code task_id
    session_id="$(get_agent_session_id "$agent")"
    pid="$(get_agent_pid "$agent")"
    log_file="$(get_agent_log "$agent")"
    agent_status="$(json_read "$AGENT_DIR/$agent.json" "status")"
    exit_code="$(json_read "$AGENT_DIR/$agent.json" "exit_code")"
    task_id="$(json_read "$AGENT_DIR/$agent.json" "task_id")"

    # Determine accurate status:
    # - Exit file exists → COMPLETED (or FAILED if non-zero exit code)
    # - PID alive, no exit file → BUSY (task genuinely running)
    # - PID dead, no exit file, has task → STALE (crashed without completion)
    # - No PID, no task → IDLE
    local display_status
    if [ -n "$task_id" ] && [ -f "$LOG_DIR/${task_id}.exit" ]; then
      if [ "$exit_code" = "0" ] || [ -z "$exit_code" ]; then
        display_status="COMPLETED"
      else
        display_status="FAILED (exit=$exit_code)"
      fi
    elif is_agent_busy "$agent"; then
      display_status="BUSY"
    elif [ -n "$pid" ] && [ -n "$task_id" ] && ! kill -0 "$pid" 2>/dev/null; then
      display_status="STALE (pid dead, no exit file)"
    elif [ -n "$session_id" ]; then
      display_status="IDLE"
    else
      display_status="IDLE"
    fi

    echo "  $agent:"
    echo "    worktree: $wt"
    echo "    session_id: ${session_id:-(none)}"
    echo "    pid: ${pid:-(none)}"
    echo "    log: ${log_file:-(none)}"
    echo "    status: $display_status"
    echo ""
  done

  echo "--- Sessions ---"
  for sf in "$SESSION_DIR"/*.json; do
    [ -f "$sf" ] || continue
    local sid agent task status
    sid="$(basename "$sf" .json)"
    agent="$(json_read "$sf" "agent")"
    task="$(json_read "$sf" "task")"
    status="$(json_read "$sf" "status")"
    echo "  $sid: agent=$agent task=${task:0:50} status=$status"
  done
  [ -f "$SESSION_DIR"/*.json ] 2>/dev/null || echo "  (no sessions)"
  echo ""

  echo "--- Tasks ---"
  for tf in "$TASK_DIR"/*.json; do
    [ -f "$tf" ] || continue
    local tid agent status commit_sha created
    tid="$(basename "$tf" .json)"
    agent="$(json_read "$tf" "agent")"
    status="$(json_read "$tf" "status")"
    commit_sha="$(json_read "$tf" "commit_sha")"
    created="$(json_read "$tf" "created_at")"
    echo "  $tid: agent=$agent status=$status commit_sha=${commit_sha:-none} created=$created"
  done
  [ -f "$TASK_DIR"/*.json ] 2>/dev/null || echo "  (no tasks)"
  echo ""

  echo "--- Integration branch ---"
  local ibranch ihead
  ibranch="$(git -C "$INTEGRATION_WORKTREE" branch --show-current 2>/dev/null || echo "unknown")"
  ihead="$(git -C "$INTEGRATION_WORKTREE" rev-parse --short HEAD 2>/dev/null || echo "unknown")"
  echo "  branch: $ibranch"
  echo "  head: $ihead"
  echo ""

  echo "=== status complete ==="
}

cmd_dispatch() {
  local agent="${1:-}"
  local task="${2:-}"

  if [ -z "$agent" ] || [ -z "$task" ]; then
  echo "Usage: fst-team dispatch <agent> <task>" >&2
  echo "  Agents: fst-research, fst-implementation, fst-verification, fst-debugging" >&2
  exit 4
  fi

  if ! is_valid_agent "$agent"; then
    echo "ERROR: unknown agent '$agent'. Valid: fst-research, fst-implementation, fst-verification, fst-debugging" >&2
    exit 4
  fi

  init_state

  # Duplicate-dispatch prevention
  if is_agent_busy "$agent"; then
    echo "ERROR: $agent already has an active task (duplicate dispatch prevented)" >&2
    exit 2
  fi

  local worktree="${AGENT_WORKTREE[$agent]}"
  local task_id="task_$(now_epoch)_${agent}"
  local log_file="$LOG_DIR/${agent}-${task_id}.log"
  local started_at
  started_at="$(now_iso)"

  echo "Dispatching $agent..."
  echo "  Task: $task"
  echo "  Worktree: $worktree"
  echo "  Task ID: $task_id"

  # Write task file
  echo "{\"agent\":\"$agent\",\"task\":\"$(echo "$task" | sed 's/"/\\"/g')\",\"status\":\"pending\",\"created_at\":\"$started_at\",\"log_file\":\"$log_file\"}" > "$TASK_DIR/$task_id.json"

  # Session IDs already present in this worktree before launch (used to detect the new session).
  local before_sessions=""
  before_sessions="$("$KILO_BIN" session list --format json 2>/dev/null \
    | python3 -c "
import json, sys, os
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
wt = os.environ.get('WT','')
print(' '.join(s.get('id','') for s in data if s.get('directory') == wt))
" 2>/dev/null)"
  WT="$worktree"
  export WT
  export BEFORE="$before_sessions"

  # Launch kilo run fully detached (setsid) so the worker survives the caller
  # and is not interrupted when the dispatch command returns. stdin is closed
  # so kilo cannot hold the caller's terminal. A subshell captures the actual
  # process exit code to a sidecar file so collect can report real exit status.
  # Variables are passed as positional args so free-form task text is safe.
  setsid bash -c '
    KILO_BIN="$1"; agent="$2"; worktree="$3"; log_file="$4"; exit_file="$5"; task="$6"
    "$KILO_BIN" run \
      --agent "$agent" \
      --dir "$worktree" \
      --format json \
      --auto \
      --title "fst-team: $task" \
      "$task" < /dev/null > "$log_file" 2>&1
    echo $? > "$exit_file"
  ' _ "$KILO_BIN" "$agent" "$worktree" "$log_file" "$LOG_DIR/${task_id}.exit" "$task" \
    < /dev/null >> "$log_file" 2>&1 &
  local pid=$!
  disown "$pid" 2>/dev/null || true

  # Persist session ID from verified Kilo CLI output (kilo session list), not
  # from buffered log greps. This fixes the previous "(none)" session IDs.
  local session_id=""
  local waited=0
  while [ "$waited" -lt 20 ]; do
    # Process may still be running; session appears in kilo session list once created.
    local new_sessions
    new_sessions="$("$KILO_BIN" session list --format json 2>/dev/null \
      | python3 -c "
import json, sys, os
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
wt = os.environ.get('WT','')
before = set(os.environ.get('BEFORE','').split())
print(' '.join(s.get('id','') for s in data if s.get('directory') == wt and s.get('id','') not in before))
" 2>/dev/null)"
    if [ -n "$new_sessions" ]; then
      session_id="$(echo "$new_sessions" | awk '{print $1}')"
      break
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      # Process exited; try once more to pick up any session it created.
      new_sessions="$("$KILO_BIN" session list --format json 2>/dev/null \
        | python3 -c "
import json, sys, os
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
wt = os.environ.get('WT','')
before = set(os.environ.get('BEFORE','').split())
print(' '.join(s.get('id','') for s in data if s.get('directory') == wt and s.get('id','') not in before))
" 2>/dev/null)"
      if [ -n "$new_sessions" ]; then
        session_id="$(echo "$new_sessions" | awk '{print $1}')"
      fi
      break
    fi
    sleep 1
    waited=$((waited + 1))
  done

  # Write agent state
  echo "{\"session_id\":\"$session_id\",\"pid\":\"$pid\",\"log_file\":\"$log_file\",\"task\":\"$task\",\"task_id\":\"$task_id\",\"status\":\"running\",\"started_at\":\"$started_at\"}" > "$AGENT_DIR/$agent.json"

  # Write session state
  echo "{\"session_id\":\"$session_id\",\"agent\":\"$agent\",\"task\":\"$task\",\"task_id\":\"$task_id\",\"pid\":\"$pid\",\"log_file\":\"$log_file\",\"status\":\"running\",\"started_at\":\"$started_at\"}" > "$SESSION_DIR/${session_id:-$task_id}.json"

  # Update task status
  json_write "$TASK_DIR/$task_id.json" "status" "running"
  json_write "$TASK_DIR/$task_id.json" "session_id" "$session_id"
  json_write "$TASK_DIR/$task_id.json" "pid" "$pid"
  json_write "$TASK_DIR/$task_id.json" "started_at" "$started_at"

  echo "  Session ID: ${session_id:-(pending — will be resolved on collect)}"
  echo "  PID: $pid"
  echo "  Log: $log_file"
  echo "  Exit-code file: $LOG_DIR/${task_id}.exit"
  echo "  Status: dispatched (running in background)"
  echo ""
  echo "  Use: fst-team collect $task_id   (to wait for completion and get results)"
}

cmd_collect() {
  local session_id_or_task="${1:-}"

  if [ -z "$session_id_or_task" ]; then
    echo "Usage: fst-team collect <session_id|task_id>" >&2
    exit 4
  fi

  init_state

  # Resolve session ID from task ID if needed
  local session_id agent pid log_file task_id
  if echo "$session_id_or_task" | grep -q '^ses_'; then
    session_id="$session_id_or_task"
    agent="$(json_read "$SESSION_DIR/$session_id.json" "agent")"
    pid="$(json_read "$SESSION_DIR/$session_id.json" "pid")"
    log_file="$(json_read "$SESSION_DIR/$session_id.json" "log_file")"
    task_id="$(json_read "$SESSION_DIR/$session_id.json" "task_id")"
  elif [ -f "$TASK_DIR/$session_id_or_task.json" ]; then
    task_id="$session_id_or_task"
    agent="$(json_read "$TASK_DIR/$session_id_or_task.json" "agent")"
    pid="$(json_read "$TASK_DIR/$session_id_or_task.json" "pid")"
    log_file="$(json_read "$TASK_DIR/$session_id_or_task.json" "log_file")"
    session_id="$(json_read "$TASK_DIR/$session_id_or_task.json" "session_id")"
  else
    echo "ERROR: session or task '$session_id_or_task' not found" >&2
    exit 3
  fi

  if [ -z "$log_file" ] || [ ! -f "$log_file" ]; then
    echo "ERROR: no log file for session $session_id" >&2
    exit 3
  fi

  echo "=== Collect: session $session_id ==="
  echo "  Agent: ${agent:-(unknown)}"
  echo "  Log: $log_file"

  # Wait for task completion. The authoritative completion signal is the
  # exit file written by the bash wrapper after `kilo run` exits. We also
  # treat PID death without an exit file as task failure.
  local exit_code=0
  local exit_file="$LOG_DIR/${task_id}.exit"
  local session_done=0
  local task_failed=0
  local waited=0

  while [ "$waited" -lt "$MAX_WAIT_SECONDS" ]; do
    # Check for exit file first (task completed cleanly)
    if [ -f "$exit_file" ]; then
      exit_code="$(cat "$exit_file" 2>/dev/null | tr -d '[:space:]')"
      [ -z "$exit_code" ] && exit_code=0
      session_done=1
      break
    fi

    # Check if PID died without exit file (task failed/crashed)
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      session_done=1
      task_failed=1
      exit_code=1
      break
    fi

    # Also check kilo session status as a secondary signal
    if [ -n "$session_id" ]; then
      local st
      st="$("$KILO_BIN" session list --format json 2>/dev/null \
        | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for s in data:
    if s.get('id') == '$session_id':
        print(s.get('status', {}).get('type', 'unknown'))
        sys.exit(0)
sys.exit(0)
" 2>/dev/null)"
      case "$st" in
        failed|error) session_done=1; task_failed=1; exit_code=1; break ;;
      esac
    fi

    sleep "$SESSION_POLL_INTERVAL"
    waited=$((waited + SESSION_POLL_INTERVAL))
  done

  if [ "$session_done" -eq 1 ]; then
    if [ "$task_failed" -eq 1 ]; then
      echo "  Status: FAILED (exit code: $exit_code)"
    else
      echo "  Status: COMPLETED (exit code: $exit_code)"
    fi
  else
    echo "  Status: STILL RUNNING (exit code: $exit_code, waited ${waited}s)"
  fi

  local collect_status="completed"
  if [ "$task_failed" -eq 1 ]; then
    collect_status="failed"
  fi
  echo "  Status: ${collect_status^^} (exit code: $exit_code)"
  echo ""

  # If session_id was empty (buffered output), extract it now from the log
  if [ -z "$session_id" ]; then
    session_id="$(extract_session_id "$log_file")"
    if [ -n "$session_id" ]; then
      json_write "$SESSION_DIR/${session_id}.json" "session_id" "$session_id"
      json_write "$AGENT_DIR/$agent.json" "session_id" "$session_id"
      json_write "$TASK_DIR/$session_id_or_task.json" "session_id" "$session_id"
    fi
  fi

  # Extract commit SHAs and reject invalid / all-zero placeholder SHAs.
  local shas
  shas="$(extract_commit_shas "$log_file" \
    | grep -vE '^0{40}$' \
    | grep -E '^[0-9a-f]{40}$' \
    | sort -u)"
  if [ -n "$shas" ]; then
    echo "--- Commit SHA(s) found ---"
    echo "$shas"
    echo ""
  fi

  # Extract text output
  echo "--- Agent output ---"
  extract_text_output "$log_file"
  echo ""

  # Update state files
  json_write "$SESSION_DIR/$session_id.json" "status" "$collect_status"
  json_write "$SESSION_DIR/$session_id.json" "exit_code" "$exit_code"
  json_write "$SESSION_DIR/$session_id.json" "completed_at" "$(now_iso)"
  if [ -n "$shas" ]; then
    json_write "$SESSION_DIR/$session_id.json" "commit_sha" "$(echo "$shas" | head -1)"
  fi

  local agent_status="$collect_status"
  json_write "$AGENT_DIR/$agent.json" "status" "$agent_status"
  json_write "$AGENT_DIR/$agent.json" "exit_code" "$exit_code"

  if [ -n "$session_id_or_task" ] && [ -f "$TASK_DIR/$session_id_or_task.json" ]; then
    json_write "$TASK_DIR/$session_id_or_task.json" "status" "$collect_status"
    json_write "$TASK_DIR/$session_id_or_task.json" "exit_code" "$exit_code"
    json_write "$TASK_DIR/$session_id_or_task.json" "completed_at" "$(now_iso)"
    if [ -n "$shas" ]; then
      json_write "$TASK_DIR/$session_id_or_task.json" "commit_sha" "$(echo "$shas" | head -1)"
    fi
  fi

  # Automatic publishing: after a successful committed task, push the agent's
  # team/* branch. Only when the task completed with exit code 0 and produced
  # a commit SHA that is present on the agent's branch (exact-SHA validation).
  if [ "$collect_status" = "completed" ] && [ "$exit_code" = "0" ] && [ -n "$shas" ]; then
    local first_sha
    first_sha="$(echo "$shas" | head -1)"
    auto_push_after_collect "$agent" "$first_sha"
  fi

  echo "=== collect complete ==="
}

cmd_resume() {
  local session_id="${1:-}"
  local message="${2:-}"

  if [ -z "$session_id" ]; then
    echo "Usage: fst-team resume <session_id> [message]" >&2
    exit 4
  fi

  init_state

  echo "Resuming session $session_id..."
  local agent
  agent="$(json_read "$SESSION_DIR/$session_id.json" "agent")"
  if [ -n "$agent" ]; then
    echo "  Agent: $agent"
  fi

  if [ -n "$message" ]; then
    "$KILO_BIN" run --session "$session_id" --format json --auto "$message"
  else
    "$KILO_BIN" run --session "$session_id" --format json --auto "Continue with the next step of your assigned task. Report progress and any commit SHA produced."
  fi
}

cmd_sync() {
  echo "=== fst-team sync ==="
  echo ""

  echo "--- Inspecting all five worktrees ---"
  for agent in fst-integration fst-research fst-implementation fst-verification fst-debugging; do
    local wt
    if [ "$agent" = "fst-integration" ]; then
      wt="$INTEGRATION_WORKTREE"
    else
      wt="${AGENT_WORKTREE[$agent]}"
    fi
    local branch head dirty
    branch="$(git -C "$wt" branch --show-current 2>/dev/null || echo "unknown")"
    head="$(git -C "$wt" rev-parse HEAD 2>/dev/null || echo "unknown")"
    dirty="$(git -C "$wt" status --porcelain 2>/dev/null | wc -l)"
    echo "  $agent: $branch @ ${head:0:12} (dirty_files=$dirty)"
  done
  echo ""

  echo "--- Reading integration ledger from team/integration ref ---"
  git show team/integration:docs/fst/operations/integration-status.md 2>/dev/null | head -15
  echo "..."
  echo ""

  echo "--- Reading implementation ledger from team/implementation ref ---"
  git show team/implementation:docs/fst/operations/implementation-status.md 2>/dev/null | head -10
  echo "..."
  echo ""

  echo "--- Reading verification ledger from team/verification ref ---"
  git show team/verification:docs/fst/operations/verification-status.md 2>/dev/null | head -10
  echo "..."
  echo ""

  echo "--- Reading defect register from team/debugging ref ---"
  git show team/debugging:docs/fst/operations/defect-register.md 2>/dev/null | head -10
  echo "..."
  echo ""

  echo "--- Reading research ledger from team/research ref ---"
  git show team/research:docs/fst/operations/research-status.md 2>/dev/null | head -10
  echo "..."
  echo ""

  echo "=== sync complete ==="
}

###############################################################################
# cmd_push — publish team/* branches to origin (permanent GitHub sync)
###############################################################################

cmd_push() {
  local target="${1:-all}"

  # Validate target: only team/* branches allowed, never main
  if [ "$target" != "all" ]; then
    case "$target" in
      team/*) ;;
      *)
        echo "ERROR: only team/* branches may be published; '$target' is not allowed" >&2
        echo "       main is excluded from automatic publishing." >&2
        exit 4
        ;;
    esac
  fi

  echo "=== fst-team push (permanent GitHub synchronization) ==="
  echo "Remote: origin ($(git remote get-url origin 2>/dev/null))"
  echo "Target: $target"
  echo ""

  # Confirm remote is reachable
  if ! git ls-remote --exit-code origin >/dev/null 2>&1; then
    echo "ERROR: cannot reach remote 'origin'. Aborting push." >&2
    exit 4
  fi

  # List branches to push
  local branches=()
  if [ "$target" = "all" ]; then
    branches=(team/integration team/implementation team/verification team/debugging team/research)
  else
    branches=("$target")
  fi

  local pushed=0 failed=0 skipped=0
  for branch in "${branches[@]}"; do
    echo "--- Processing $branch ---"

    # Confirm branch exists locally
    if ! git rev-parse --verify "$branch" >/dev/null 2>&1; then
      echo "  SKIP: local branch '$branch' does not exist"
      skipped=$((skipped + 1))
      continue
    fi

    local local_sha remote_sha
    local_sha="$(git rev-parse "$branch")"
    remote_sha="$(git ls-remote origin "refs/heads/$branch" 2>/dev/null | awk '{print $1}')"

    if [ -z "$remote_sha" ]; then
      echo "  NEW: branch '$branch' does not exist on origin; will create it"
      echo "  Local SHA: $local_sha"
    else
      echo "  Local SHA:  $local_sha"
      echo "  Remote SHA: $remote_sha"

      # Check ancestry: local must be a descendant of remote (or equal)
      if git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
        echo "  Ancestry: OK — local is descendant of remote (fast-forward possible)"
      elif git merge-base --is-ancestor "$local_sha" "$remote_sha" 2>/dev/null; then
        echo "  SKIP: remote is ahead of local; nothing to push"
        skipped=$((skipped + 1))
        continue
      else
        echo "  DIVERGED: local and remote have diverged; refusing to push (would require force)"
        echo "  Report this divergence — do not force-push."
        failed=$((failed + 1))
        continue
      fi
    fi

    # Perform ordinary fast-forward push (no --force, no --delete)
    echo "  Pushing $branch -> origin/$branch ..."
    if git push origin "$branch" 2>&1; then
      echo "  OK: $branch pushed successfully"
      pushed=$((pushed + 1))
    else
      echo "  FAILED: push of $branch was rejected"
      failed=$((failed + 1))
    fi
    echo ""
  done

  echo "=== Push summary: $pushed pushed, $failed failed, $skipped skipped ==="
  if [ "$failed" -gt 0 ]; then
    exit 4
  fi
}

###############################################################################
# agent_to_branch — map an agent role to its team/* branch
###############################################################################

agent_to_branch() {
  local agent="$1"
  case "$agent" in
    fst-implementation) echo "team/implementation" ;;
    fst-verification)   echo "team/verification" ;;
    fst-debugging)      echo "team/debugging" ;;
    fst-research)       echo "team/research" ;;
    fst-integration)    echo "team/integration" ;;
    *)                  echo "" ;;
  esac
}

###############################################################################
# auto_push_branch — automatically publish a team/* branch after a successful commit
#
# Preconditions (all must hold, otherwise no push):
#   - Branch exists locally and is a team/* branch (never main)
#   - Branch HEAD is a committed SHA (no uncommitted changes considered)
#   - Remote is reachable
#   - Local is a descendant of remote (fast-forward possible)
#   - Remote is not ahead of local
#   - Branches have not diverged
#
# Returns 0 on successful push, 1 on skip/failure (no error exit).
###############################################################################

auto_push_branch() {
  local branch="$1"
  local reason="${2:-automatic publish after successful commit}"

  # Validate: only team/* branches, never main
  case "$branch" in
    team/*) ;;
    *)
      echo "  AUTO-PUSH SKIP: '$branch' is not a team/* branch (main is excluded)"
      return 1
      ;;
  esac

  # Confirm branch exists locally
  if ! git rev-parse --verify "$branch" >/dev/null 2>&1; then
    echo "  AUTO-PUSH SKIP: local branch '$branch' does not exist"
    return 1
  fi

  # Confirm remote is reachable
  if ! git ls-remote --exit-code origin >/dev/null 2>&1; then
    echo "  AUTO-PUSH SKIP: remote 'origin' not reachable"
    return 1
  fi

  local local_sha remote_sha
  local_sha="$(git rev-parse "$branch")"
  remote_sha="$(git ls-remote origin "refs/heads/$branch" 2>/dev/null | awk '{print $1}')"

  echo "  AUTO-PUSH: $branch ($reason) — local=$local_sha"

  if [ -z "$remote_sha" ]; then
    echo "  AUTO-PUSH: branch '$branch' does not exist on origin; creating it"
  else
    echo "  AUTO-PUSH: remote=$remote_sha"
    if git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "  AUTO-PUSH: ancestry OK — fast-forward possible"
    elif git merge-base --is-ancestor "$local_sha" "$remote_sha" 2>/dev/null; then
      echo "  AUTO-PUSH: SKIP — remote is ahead of local, nothing to push"
      return 0
    else
      echo "  AUTO-PUSH: DIVERGED — refusing to push (would require force-push)"
      return 1
    fi
  fi

  # Perform ordinary fast-forward push (no --force, no --delete)
  echo "  AUTO-PUSH: pushing $branch -> origin/$branch ..."
  if git push origin "$branch" 2>&1; then
    echo "  AUTO-PUSH: OK — $branch published"
    return 0
  else
    echo "  AUTO-PUSH: FAILED — push of $branch was rejected"
    return 1
  fi
}

###############################################################################
# auto_push_after_collect — trigger automatic push after a successful collect
#
# Called from cmd_collect when a task completed with exit code 0 and produced
# a commit SHA. Pushes the agent's team/* branch only if the commit is present
# on that branch (exact-SHA validation).
###############################################################################

auto_push_after_collect() {
  local agent="$1"
  local commit_sha="$2"

  if [ -z "$agent" ] || [ -z "$commit_sha" ]; then
    return 0
  fi

  # Only auto-push for completed, successful tasks
  local status
  status="$(json_read "$AGENT_DIR/$agent.json" "status" 2>/dev/null || echo "")"
  if [ "$status" != "completed" ]; then
    echo "  AUTO-PUSH: $agent status is '$status', not 'completed' — skipping"
    return 0
  fi

  local branch
  branch="$(agent_to_branch "$agent")"
  if [ -z "$branch" ]; then
    echo "  AUTO-PUSH: no branch mapping for agent '$agent' — skipping"
    return 0
  fi

  # Exact-SHA validation: confirm the collected commit SHA is on the agent's branch
  if ! git merge-base --is-ancestor "$commit_sha" "$branch" 2>/dev/null; then
    echo "  AUTO-PUSH: commit $commit_sha is NOT on branch $branch — skipping push"
    return 1
  fi

  auto_push_branch "$branch" "successful commit $commit_sha by $agent"
}

###############################################################################
# cmd_stop — stop a running session
###############################################################################

cmd_stop() {
  local session_id="${1:-}"

  if [ -z "$session_id" ]; then
    echo "Usage: fst-team stop <session_id>" >&2
    exit 4
  fi

  init_state

  local pid
  pid="$(json_read "$SESSION_DIR/$session_id.json" "pid")"

  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    echo "Stopping session $session_id (PID $pid)..."
    kill "$pid" 2>/dev/null || true
    sleep 2
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null || true
    fi
    echo "  Stopped."
  else
    echo "Session $session_id: no running process found."
  fi

  json_write "$SESSION_DIR/$session_id.json" "status" "stopped"
  json_write "$SESSION_DIR/$session_id.json" "stopped_at" "$(now_iso)"
}

###############################################################################
# cmd_cleanup — recover correct state from stale/crashed processes
###############################################################################

cmd_cleanup() {
  init_state
  local cleaned=0
  for agent in fst-research fst-implementation fst-verification fst-debugging; do
    local pid task_id session_id status exit_code
    pid="$(json_read "$AGENT_DIR/$agent.json" "pid")"
    task_id="$(json_read "$AGENT_DIR/$agent.json" "task_id")"
    session_id="$(json_read "$AGENT_DIR/$agent.json" "session_id")"
    status="$(json_read "$AGENT_DIR/$agent.json" "status")"

    # No active task → nothing to clean
    if [ -z "$pid" ] && [ -z "$task_id" ]; then
      continue
    fi

    # Exit file exists but state not updated → reconcile
    if [ -n "$task_id" ] && [ -f "$LOG_DIR/${task_id}.exit" ]; then
      local ec
      ec="$(cat "$LOG_DIR/${task_id}.exit" 2>/dev/null | tr -d '[:space:]')"
      [ -z "$ec" ] && ec=0
      if [ "$status" != "completed" ] && [ "$status" != "failed" ]; then
        if [ "$ec" = "0" ]; then
          json_write "$AGENT_DIR/$agent.json" "status" "completed"
        else
          json_write "$AGENT_DIR/$agent.json" "status" "failed"
        fi
        json_write "$AGENT_DIR/$agent.json" "exit_code" "$ec"
        if [ -n "$session_id" ]; then
          json_write "$SESSION_DIR/$session_id.json" "status" "$( [ "$ec" = "0" ] && echo completed || echo failed )"
          json_write "$SESSION_DIR/$session_id.json" "exit_code" "$ec"
        fi
        if [ -n "$task_id" ] && [ -f "$TASK_DIR/$task_id.json" ]; then
          json_write "$TASK_DIR/$task_id.json" "status" "$( [ "$ec" = "0" ] && echo completed || echo failed )"
          json_write "$TASK_DIR/$task_id.json" "exit_code" "$ec"
        fi
        echo "  $agent: reconciled exit file (exit=$ec) → $( [ "$ec" = "0" ] && echo COMPLETED || echo FAILED )"
        cleaned=1
      fi
      continue
    fi

    # PID dead, no exit file → stale/failed task
    if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
      if [ "$status" != "failed" ] && [ "$status" != "stale" ]; then
        json_write "$AGENT_DIR/$agent.json" "status" "failed"
        json_write "$AGENT_DIR/$agent.json" "exit_code" "1"
        if [ -n "$session_id" ]; then
          json_write "$SESSION_DIR/$session_id.json" "status" "failed"
          json_write "$SESSION_DIR/$session_id.json" "exit_code" "1"
        fi
        if [ -n "$task_id" ] && [ -f "$TASK_DIR/$task_id.json" ]; then
          json_write "$TASK_DIR/$task_id.json" "status" "failed"
          json_write "$TASK_DIR/$task_id.json" "exit_code" "1"
        fi
        echo "  $agent: PID $pid dead, no exit file → FAILED (stale)"
        cleaned=1
      fi
      continue
    fi

    # PID alive, no exit file → genuinely running, nothing to clean
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "  $agent: PID $pid alive, no exit file → still running (no cleanup)"
      continue
    fi
  done

  if [ "$cleaned" -eq 0 ]; then
    echo "  No stale state found."
  fi
  echo "=== cleanup complete ==="
}

###############################################################################
# Main
###############################################################################

main() {
  local cmd="${1:-}"
  shift || true

  case "$cmd" in
    status)   cmd_status "$@" ;;
    dispatch) cmd_dispatch "$@" ;;
    resume)   cmd_resume "$@" ;;
    collect)  cmd_collect "$@" ;;
    sync)     cmd_sync "$@" ;;
    stop)     cmd_stop "$@" ;;
    push)     cmd_push "$@" ;;
    cleanup)  cmd_cleanup "$@" ;;
    doctor)   cmd_doctor "$@" ;;
    *)
      echo "fst-team — FST four-agent CLI orchestrator"
      echo ""
      echo "Usage: fst-team <command> [args...]"
      echo ""
      echo "Commands:"
      echo "  status                        Show all agents, sessions, tasks, worktrees"
      echo "  dispatch <agent> <task>       Dispatch a task to a worker agent (async)"
      echo "  resume <session_id> [msg]     Resume an existing Kilo session by ID"
      echo "  collect <session_id|task_id>  Wait for completion and collect results"
      echo "  sync                          Synchronize branches and read ledgers from refs"
      echo "  stop <session_id>             Stop a running session"
      echo "  cleanup                       Reconcile stale/crashed process state"
      echo "  doctor                        Health check: CLI, agents, worktrees, state"
      echo ""
      echo "Agents: fst-research, fst-implementation, fst-verification, fst-debugging"
      echo "State: $STATE_DIR (runtime-only, never committed)"
      exit 4
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi